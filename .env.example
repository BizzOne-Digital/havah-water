# Copy to .env.local (never commit real values).

# Public site URL — used for canonical URLs, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where contact-form leads are POSTed as JSON (Zapier/Make/CRM inbound webhook).
# Until set, the form shows an honest "not connected yet — please call" message.
CONTACT_WEBHOOK_URL=
